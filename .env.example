# === Otobüs Bilet Sistemi — Environment Variables ===
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
# cp .env.example .env

# Aiven MySQL Şifresi
AIVEN_DB_PASSWORD=buraya_sifrenizi_yazin

# JWT Secret Key (hex encoded)
JWT_SECRET=buraya_jwt_secret_yazin

# Mail Ayarları (Gmail SMTP — App Password)
MAIL_USERNAME=ornek@gmail.com
MAIL_PASSWORD=buraya_app_password_yazin
